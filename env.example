# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Fashn API Key
FASHN_API_KEY=your_fashn_api_key_here

# Database URL (Render에서 자동으로 제공되지만, 로컬 개발 시에는 비워두면 SQLite 사용)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Flask Debug Mode (로컬 개발 시에만 true로 설정)
FLASK_DEBUG=false

# Port (Render에서 자동으로 제공되므로 로컬 개발 시에만 필요)
# PORT=5001


